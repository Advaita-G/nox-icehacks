# Server-side placeholders only. Keep real credentials in your local environment or deployment secrets.
# Live calls stay disabled unless a provider and approved runtime are explicitly configured.
NOX_LIVE_CALLS=disabled
NOX_MODEL_PROVIDER=momen
# Production judge gate only: use a random value of at least 32 characters as a server secret.
NOX_DEMO_ACCESS_CODE=
NOX_MOMEN_PROJECT_EX_ID=replace-with-project-exId
NOX_MOMEN_ADMIN_TOKEN=replace-with-admin-token
NOX_MOMEN_AGENT_ID=replace-with-agent-id
NOX_MOMEN_ARG_INSTRUCTIONS=replace-with-argKey-of-instructions
NOX_MOMEN_ARG_REQUEST=replace-with-argKey-of-request
NOX_MOMEN_ARG_IMAGE=replace-with-argKey-of-image
# Optional direct Cloudflare Workers AI runtime. Select NOX_MODEL_PROVIDER=cloudflare explicitly.
# Use a Free account with its hard daily quota; do not enable paid overages.
NOX_CLOUDFLARE_ACCOUNT_ID=
NOX_CLOUDFLARE_API_TOKEN=
NOX_CLOUDFLARE_MODEL=@cf/google/gemma-4-26b-a4b-it
# Application output cap, 1–16384; sent as max_completion_tokens.
NOX_CLOUDFLARE_MAX_TOKENS=8192
